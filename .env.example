# Cấu hình máy chủ. Chép file này thành `.env.local` rồi điền giá trị.
#
# KHÔNG CÒN BIẾN `VITE_` NÀO, và cũng không còn khoá `anon`. Trình duyệt giờ chỉ
# nói chuyện với `/api` trên chính tên miền của app; nó không biết Supabase tồn
# tại. Cả ba giá trị dưới đây chỉ sống trong tiến trình Node.
#
# Cũng KHÔNG CÒN chế độ chạy thử không cần cấu hình: app yêu cầu luôn có máy chủ,
# nên thiếu biến nào thì route liên quan báo lỗi kèm đúng tên biến còn thiếu.

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Dashboard > Project Settings > API > service_role (secret)
#
# Khoá này BỎ QUA toàn bộ Row Level Security. Nó mà lọt ra ngoài là lọt toàn bộ
# dữ liệu của mọi đứa trẻ. Không bao giờ đặt tiền tố `NEXT_PUBLIC_` cho nó, không
# bao giờ commit `.env.local`, và nếu nghi ngờ bị lộ thì vào Dashboard xoay khoá
# mới ngay.
SUPABASE_SERVICE_ROLE_KEY=

# Khoá ký cookie phiên đăng nhập. Sinh một chuỗi ngẫu nhiên dài:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Đổi khoá này là mọi người đang đăng nhập bị đăng xuất - đó cũng chính là cách
# đá tất cả mọi người ra ngoài khi cần.
SESSION_SECRET=

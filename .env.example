# Cấu hình Supabase.
# Sao chép file này thành .env.local rồi điền giá trị của dự án bạn.
#
# BỎ TRỐNG cũng được: khi đó app chạy hoàn toàn offline trên máy, không cần tài
# khoản. Đây là cách nhanh nhất để chạy thử.
#
# Lấy hai giá trị này ở Supabase Dashboard > Project Settings > API.
# Khoá anon là khoá CÔNG KHAI, an toàn khi để trong mã nguồn frontend —
# phân quyền thật nằm ở Row Level Security phía server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
